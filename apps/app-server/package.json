{
  "name": "@react-fastify-template/app-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @zhishu/document-contracts build",
    "dev": "tsx watch src/server.ts",
    "prebuild": "pnpm --filter @zhishu/document-contracts build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "pretypecheck": "pnpm --filter @zhishu/document-contracts build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src database",
    "preopenapi:export": "pnpm --filter @zhishu/document-contracts build",
    "openapi:export": "tsx src/scripts/openapi-export.ts",
    "db:generate": "drizzle-kit generate --config database/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config database/drizzle.config.ts",
    "ai:setup": "tsx src/scripts/ai-setup.ts",
    "smoke:ai": "tsx src/scripts/ai-smoke.ts",
    "smoke:template-copy": "tsx src/scripts/template-copy-smoke.ts",
    "smoke:repair-block-ids": "tsx src/scripts/repair-duplicate-block-ids-smoke.ts",
    "assets:cleanup": "tsx src/scripts/cleanup-asset-orphans.ts",
    "smoke:asset-references": "tsx src/scripts/asset-reference-smoke.ts",
    "smoke:projection": "tsx src/scripts/projection-outbox-smoke.ts",
    "smoke:backup-restore": "tsx src/scripts/backup-restore-smoke.ts",
    "smoke:knowledge": "tsx src/scripts/knowledge-smoke.ts",
    "test:workspace-policy": "tsx --test src/modules/documents/workspace-access.test.ts",
    "maintenance:compact-updates": "tsx src/scripts/compact-document-updates.ts",
    "projection:backfill": "tsx src/scripts/projection-backfill.ts",
    "maintenance:repair-block-ids": "tsx src/scripts/repair-duplicate-block-ids.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@hocuspocus/server": "^4.7.0",
    "@langchain/anthropic": "1.5.0",
    "@langchain/core": "1.2.14",
    "@langchain/langgraph-checkpoint-postgres": "1.0.1",
    "@langchain/openai": "1.3.0",
    "@tiptap/core": "^3.30.3",
    "@tiptap/pm": "^3.30.3",
    "@tiptap/y-tiptap": "^3.0.7",
    "@zhishu/ai-contracts": "workspace:^",
    "@zhishu/ai-runtime": "workspace:^",
    "@zhishu/document-contracts": "workspace:*",
    "@zhishu/editor-core": "workspace:^",
    "@zhishu/rag": "workspace:^",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.7.2",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "pg": "^8.13.1",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^3.24.1",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2",
    "@zhishu/dsh-agent": "workspace:*",
    "@zhishu/chat-contracts": "workspace:*",
    "@zhishu/ai-plugins": "workspace:*",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@hocuspocus/provider": "4.7.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2"
  }
}
