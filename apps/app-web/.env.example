# Public browser setting; leave empty for same-origin /api requests.
VITE_API_BASE_URL=
# Vite dev/preview proxy only; never embedded in the browser bundle.
API_PROXY_TARGET=http://127.0.0.1:9010
# Auth mode (nova convention): unset = dev server uses mock login, production build
# uses Casdoor SSO. Set to "casdoor" to test SSO against a dev server, or "dev" to
# force mock mode. Production builds never enable "dev".
VITE_AUTH_MODE=

