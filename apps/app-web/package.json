{
  "name": "@react-fastify-template/app-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "routes:generate": "tsr generate",
    "api:generate": "orval --config orval.config.ts",
    "api:check": "tsx scripts/api-check.ts",
    "typecheck": "pnpm api:generate && pnpm routes:generate && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@hocuspocus/provider": "^4.7.0",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.33",
    "@tiptap/core": "^3.30.3",
    "@tiptap/extension-collaboration": "^3.30.3",
    "@tiptap/pm": "^3.30.3",
    "@tiptap/react": "^3.30.3",
    "@tiptap/y-tiptap": "^3.0.7",
    "@zhishu/editor-collaboration": "workspace:^",
    "@zhishu/editor-core": "workspace:^",
    "@zhishu/document-contracts": "workspace:^",
    "@zhishu/editor-react": "workspace:^",
    "@zhishu/editor-ui": "workspace:^",
    "clsx": "2.1.1",
    "lucide-react": "1.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "0.3.0",
    "yjs": "^13.6.33",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.34",
    "@tanstack/router-plugin": "1.168.36",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "orval": "8.30.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "vite": "8.2.2"
  }
}
