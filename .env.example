NODE_ENV=development
AUTH_MODE=mock
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
MOCK_AUTH_TOKEN_TTL_SECONDS=28800
DATABASE_URL=postgresql://postgres@localhost:5432/app
# Optional AI: configure both model and key; an OpenAI-compatible base URL may be supplied.
# AI_MODEL=your-model
# AI_API_KEY=your-server-side-key
# AI_BASE_URL=https://your-provider.example/v1
# AI_API_FORMAT=openai # optional; URLs ending in /anthropic select Anthropic automatically
# AI_THINKING=adaptive # required by MiniMax-M3.1-Flash
# AI_REASONING_EFFORT=low # optional Anthropic reasoning depth
AI_TIMEOUT_MS=120000
AI_MAX_CONCURRENT=4
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=5000
TENANT_MAX_DOCUMENTS=10000
TENANT_MAX_ASSET_BYTES=10737418240
# Optional. Set a private token of at least 32 characters to enable the protected /metrics endpoint.
# METRICS_BEARER_TOKEN=replace-with-a-private-metrics-token
# MinIO: equivalent to endPoint=minio.8and1.cn, port=80, useSSL=false.
# Configure the real service-account credentials in .env; never in frontend code.
# Without credentials, development starts with attachments unavailable.
ASSET_STORAGE_ENDPOINT=http://minio.8and1.cn:80
ASSET_STORAGE_PUBLIC_ENDPOINT=http://minio.8and1.cn:80
ASSET_STORAGE_REGION=us-east-1
ASSET_STORAGE_BUCKET=zhishu-private-assets
# ASSET_STORAGE_ACCESS_KEY_ID=your-access-key-id
# ASSET_STORAGE_SECRET_ACCESS_KEY=your-secret-access-key
ASSET_STORAGE_AUTO_CREATE_BUCKET=false
# The endpoint is temporarily unavailable. Skip bucket checks during startup.
# Set true when the service is available and provision the private bucket first.
ASSET_STORAGE_CHECK_ON_STARTUP=false
# Optional local Garage alternative: http://127.0.0.1:3900 (pnpm compose:up:storage).
# ASSET_UPLOAD_MAX_BYTES=10485760
# ASSET_UPLOAD_SESSION_TTL_SECONDS=3600
# ASSET_ACCESS_URL_TTL_SECONDS=60
# ASSET_ORPHAN_RETENTION_SECONDS=86400
COLLABORATION_PORT=3001
COLLABORATION_HOST=0.0.0.0
COLLABORATION_PUBLIC_URL=ws://localhost:3001
COLLABORATION_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
COLLABORATION_SESSION_TTL_SECONDS=300
COLLABORATION_MAX_UPDATE_BYTES=1048576
COLLABORATION_MAX_CONNECTIONS=100
COLLABORATION_MAX_ACTIVE_ROOMS=50
COLLABORATION_MAX_ROOM_CONNECTIONS=20
COLLABORATION_MAX_DOCUMENTS_PER_CONNECTION=1
COLLABORATION_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5180,http://127.0.0.1:5180
SWAGGER_UI_ENABLED=true

# Optional billable Images API; no tool is available without this pair and private storage.
# AI_IMAGE_MODEL=gpt-image-1
# AI_IMAGE_API_KEY=your-server-side-image-key
# AI_IMAGE_BASE_URL=https://api.openai.com/v1
