{
  "name": "@zhishu/ai-plugins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./writing": {
      "types": "./dist/writing/index.d.ts",
      "import": "./dist/writing/index.js"
    },
    "./research": {
