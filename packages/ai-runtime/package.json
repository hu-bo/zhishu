{
  "name": "@zhishu/ai-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Unified assistant orchestration: one DSH execution composed with the allowed plugins, unified input/output gates. No model loop, SQL layer, timers or product state of its own.",
  "type": "module",
  "sideEffects": false,
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@zhishu/ai-contracts": "workspace:*",
    "@zhishu/ai-plugins": "workspace:*",
    "@zhishu/dsh-agent": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2",
    "@types/node": "^22.10.10"
  }
}
